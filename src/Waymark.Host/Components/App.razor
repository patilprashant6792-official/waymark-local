<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Waymark.Host.styles.css"]" />
    <link rel="stylesheet" href="@Assets["waymark.css"]" />
    <link rel="stylesheet" href="@Assets["waymark-ux.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@Assets["brand/waymark-logo.svg"]" />
    <HeadOutlet @rendermode="PageMode" />
</head>

<body>
    <Routes @rendermode="PageMode" />
    <script src="@Assets["waymark.js"]"></script>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    // The admin pages talk to the circuit from the first paint; nothing is rendered twice.
    private static readonly InteractiveServerRenderMode PageMode = new(prerender: false);
}
