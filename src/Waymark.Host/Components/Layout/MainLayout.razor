@inherits LayoutComponentBase
@using MudBlazor
@using Waymark.Core.Edge
@using Waymark.Host.Components.Shared
@using Waymark.Host.Components.Ui

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="wm-skip" href="#main">Skip to content</a>

<div class="wm-shell@(ShellClass)">
    <header class="wm-header">
        <button type="button" id="wm-nav-toggle" class="wm-nav-toggle" aria-controls="main-nav" aria-expanded="@(_navCollapsed ? "false" : "true")" aria-label="@(_navCollapsed ? "Expand menu" : "Collapse menu")" title="@(_navCollapsed ? "Expand menu ( [ )" : "Collapse menu ( [ )")" @onclick="ToggleNavAsync">
            <MudIcon Icon="@Icons.Material.Outlined.ViewSidebar" />
        </button>
        <a class="wm-logo" href="">
            <img class="wm-logo-mark" src="@Assets["brand/waymark-logo.svg"]" alt="" width="28" height="28" />
            <span>Waymark</span>
        </a>

        <div class="wm-header-chips">
            <WmStatus State="ServerChip.State" Text="@ServerChip.Text" />
            <WmStatus State="TunnelChip.State" Text="@TunnelChip.Text" Title="@Status.Tunnel.Message" />
            @if (Status.PendingApprovals > 0)
            {
                <a class="wm-header-link" href="approvals"><WmStatus State="StatusState.Attention" Text="@ApprovalText" /></a>
            }
            @if (Status.PendingCommands > 0)
            {
                <a class="wm-header-link" href="console"><WmStatus State="StatusState.Attention" Text="@CommandText" /></a>
            }
            <a class="wm-header-link" href="audit?view=live"><WmStatus State="StatusState.Working" Text="@ActiveText" /></a>
        </div>

        <div class="wm-header-actions">
            <CommandPalette />
            <WmIconButton Icon="@Icons.Material.Outlined.Keyboard" Label="Keyboard shortcuts ( ? )" OnClick="ToggleShortcutsAsync" />
            <WmIconButton Icon="@(_dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                          Label="@(_dark ? "Switch to the light theme" : "Switch to the dark theme")"
                          OnClick="ToggleThemeAsync" />
            @if (Status.Paused)
            {
                <WmButton Kind="ButtonKind.Primary" Icon="@Icons.Material.Outlined.PlayArrow" Disabled="_busy" OnClick="TogglePauseAsync">Resume</WmButton>
            }
            else
            {
                <WmButton Kind="ButtonKind.Danger" Icon="@Icons.Material.Outlined.Pause" Disabled="_busy" OnClick="TogglePauseAsync">Pause all</WmButton>
            }
        </div>
    </header>

    <nav id="main-nav" class="wm-nav" aria-label="Main">
        @foreach (var group in NavCatalog.Visible.GroupBy(entry => entry.Group))
        {
            <div class="wm-nav-group">@NavCatalog.GroupLabel(group.Key)</div>
            @foreach (var entry in group)
            {
                <NavLink class="wm-nav-item" ActiveClass="active" href="@entry.Href" Match="@(entry.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@Tip(entry.Title)">
                    <MudIcon Icon="@entry.Icon" Size="Size.Small" /><span>@entry.Title</span>
                    @if (BadgeFor(entry) is { } badge)
                    {
                        <span class="wm-badge" aria-label="@badge.Text">@badge.Count</span>
                    }
                </NavLink>
            }
        }
        <div class="wm-nav-foot">v0.2 &middot; admin: local only</div>
    </nav>

    <main id="main" class="wm-main" tabindex="-1">
        <PageErrorBoundary @ref="_boundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <div class="wm-page">
            <InlineAlert Severity="Severity.Error">This page hit a problem and was stopped. It is written to the log, under Audit, Live, Errors. Open another page, or <WmLinkButton OnClick="RecoverPage">try this page again</WmLinkButton>.</InlineAlert>
                </div>
            </ErrorContent>
        </PageErrorBoundary>
    </main>
    <CallPanel />
</div>

<div id="blazor-error-ui" class="blazor-error-boundary">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>

<Waymark.Host.Components.Shared.ShortcutsPanel />
