@page "/workspaces/{WorkspaceId:long}/access"
@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Security
@using Waymark.Core.Transfer
@using Waymark.Host.Components.Shared
@using Waymark.Host.Security
@using Waymark.Host.Ui

<WorkspaceShell WorkspaceId="WorkspaceId">

    @if (!_loaded)
    {
        <p class="wm-lead" aria-live="polite">Loading...</p>
    }
    else if (_workspace is null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.FolderOpen" Title="Workspace not found" Text="It may have been removed. Go back to the list of workspaces." />
    }
    else
    {
        <SectionHeader Title="Access rules" Lead="Decide which files and folders Claude cannot open in this workspace. Your rules are added to the built-in protection and take effect at once. They never lift a built-in block, so secrets, keys, databases and version control stay protected.">
            <Actions>
                <BundleToolbar WorkspaceId="WorkspaceId" Content="BundleContent.AccessRules" ExportLabel="Export access rules" Hint="Keep your rules when you move to another computer." />
            </Actions>
        </SectionHeader>

        @if (_error is not null)
        {
            <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
        }

        <section class="wm-card" aria-labelledby="ar-explore">
            <h2 id="ar-explore" class="wm-card-title">Explore this workspace</h2>
            <p class="wm-muted">See what Claude can and cannot open. Open folders to browse, or search by name; use * and ? for patterns such as *.sql. Block anything that is still allowed with one click.</p>
            <div class="wm-row">
                <WmTextField Label="Search by name" @bind-Value="_query" Immediate="true" Width="FieldWidth.Large" HelperText="For example Legacy or *.sql" MaxLength="AccessBrowser.MaxQueryLength" OnKeyUp="OnSearchKey" />
                <WmButton OnClick="SearchAsync" Disabled="@(_exploring || string.IsNullOrWhiteSpace(_query))">Search</WmButton>
                @if (_searching)
                {
                    <WmButton Kind="ButtonKind.Ghost" OnClick="ClearSearchAsync">Back to folders</WmButton>
                }
            </div>

            @if (_searching)
            {
                <p class="wm-muted wm-note" aria-live="polite">Search results for '@_searchedFor'</p>
            }
            else
            {
                <nav class="wm-row wm-crumbs" aria-label="Folder path">
                    <WmButton Kind="ButtonKind.Ghost" Small="true" OnClick="() => OpenAsync(string.Empty)">@_workspace.Name</WmButton>
                    @foreach (var crumb in Crumbs())
                    {
                        <span aria-hidden="true">/</span>
                        <WmButton Kind="ButtonKind.Ghost" Small="true" OnClick="() => OpenAsync(crumb.Path)">@crumb.Name</WmButton>
                    }
                </nav>
            }

            @if (_listing is null)
            {
                <p class="wm-muted" aria-live="polite">@(_exploring ? "Loading..." : string.Empty)</p>
            }
            else if (_listing.Entries.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.FolderOpen" Title="@(_searching ? "Nothing found" : "Empty folder")" Text="@(_searching ? "No file or folder name matches. Folders that are always blocked are not searched inside." : "There are no files or folders here.")" />
            }
            else
            {
                <div class="wm-table-wrap">
                    <table class="wm-table">
                        <caption class="visually-hidden">Files and folders with the access Claude has to each</caption>
                        <thead>
                            <tr><th scope="col">Name</th><th scope="col">Access</th><th scope="col">Why</th><th scope="col">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _listing.Entries)
                            {
                                <tr>
                                    <th scope="row">
                                        @if (entry.IsFolder)
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" />
                                            <WmButton Kind="ButtonKind.Ghost" Small="true" OnClick="() => OpenAsync(entry.RelativePath)">@(_searching ? entry.RelativePath : entry.Name)</WmButton>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                                            <span class="wm-mono">@(_searching ? entry.RelativePath : entry.Name)</span>
                                        }
                                    </th>
                                    <td><WmStatus State="@(entry.Allowed ? StatusState.Healthy : StatusState.Failed)" Text="@(entry.Allowed ? "Allowed" : "Blocked")" /></td>
                                    <td class="wm-muted">@entry.Reason</td>
                                    <td>
                                        @if (entry.Allowed)
                                        {
                                            <WmButton Kind="ButtonKind.Danger" Small="true" Disabled="_busy" OnClick="() => BlockAsync(entry)">Block</WmButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_listing.Truncated)
                {
                    <InlineAlert Severity="Severity.Info">Only the first @(_searching ? AccessBrowser.MaxResults : AccessBrowser.MaxEntries) entries are shown. @(_searching ? "Search for something more specific." : "Search by name to find the rest.")</InlineAlert>
                }
            }
        </section>

        <section class="wm-card" aria-labelledby="ar-add">
            <h2 id="ar-add" class="wm-card-title">Add a rule</h2>
            <div class="wm-row">
                <WmSelect TValue="AccessRuleKind" Label="Rule" @bind-Value="_kind" Options="KindOptions" />
                <WmTextField Label="Pattern" @bind-Value="_pattern" HelperText="@AccessRulesText.Help(_kind)" MaxLength="AccessRuleRules.MaxPatternLength" />
                <WmTextField Label="Note (optional)" @bind-Value="_note" HelperText="Why this rule exists" MaxLength="AccessRuleRules.MaxNoteLength" />
                <WmButton Kind="ButtonKind.Primary" OnClick="AddAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_pattern))">Add rule</WmButton>
            </div>
        </section>

        <SectionHeader Title="Your rules" />
        @if (_rules.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="No rules yet" Text="Only the built-in protection applies. Block something above or add a rule." />
        }
        else
        {
            <div class="wm-table-wrap">
                <table class="wm-table">
                    <caption class="visually-hidden">Access rules of this workspace</caption>
                    <thead>
                        <tr><th scope="col">Rule</th><th scope="col">Pattern</th><th scope="col">Note</th><th scope="col">On</th><th scope="col">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in _rules)
                        {
                            <tr>
                                <td>@AccessRulesText.Label(rule.Kind)</td>
                                <th scope="row" class="wm-mono">@rule.Pattern</th>
                                <td>@rule.Note</td>
                                <td><WmSwitch Value="rule.Enabled" ValueChanged="v => ToggleAsync(rule, v)" Label="@($"Enable rule {rule.Pattern}")" /></td>
                                <td><WmButton Kind="ButtonKind.Danger" Small="true" OnClick="() => RemoveAsync(rule)">Remove</WmButton></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <section class="wm-card wm-card-actions" aria-labelledby="ar-base">
            <h2 id="ar-base" class="wm-card-title">Always blocked (built in)</h2>
            <dl class="wm-dl">
                <dt>Folders</dt>
                <dd class="wm-mono">@string.Join(", ", FileAccessPolicy.BaselineFolders.Order())</dd>
                <dt>Files</dt>
                <dd class="wm-mono">@string.Join(", ", FileAccessPolicy.BaselineFileNames.Order())</dd>
                <dt>Words in a path</dt>
                <dd class="wm-mono">@string.Join(", ", FileAccessPolicy.BaselineKeywords.Order())</dd>
                <dt>File types allowed</dt>
                <dd class="wm-mono">@string.Join(" ", Policy.AllowedExtensions.Order())</dd>
            </dl>
        </section>
    }
</WorkspaceShell>

