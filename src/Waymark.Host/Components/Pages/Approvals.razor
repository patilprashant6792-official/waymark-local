@page "/approvals"
@inherits LiveComponentBase
@using Waymark.Host.Ui

<PageFrame Title="Approvals" Lead="Apps ask to connect here, and so do commands that are set to Ask. Nothing connects or runs until you say yes.">
    @if (_error is not null)
    {
        <InlineAlert Severity="Severity.Warning">@_error</InlineAlert>
    }

    <SectionHeader Title="Waiting" />
    @foreach (var waitingCommand in _commandsWaiting)
    {
        <CommandApprovalCard @key="waitingCommand.Id" Run="waitingCommand" OnDecided="LoadAsync" />
    }
    @if (_pending.Count == 0 && _commandsWaiting.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.CheckCircle" Title="Nothing is waiting for you." Text="A pairing request stays open for five minutes." />
    }
    else
    {
        @foreach (var approval in _pending)
        {
            <section class="wm-card" aria-label="Pairing request @DisplayFormat.PairingCode(approval.PairingCode)">
                <div class="wm-row spread">
                    <div class="wm-pairing">@DisplayFormat.PairingCode(approval.PairingCode)</div>
                    <WmStatus State="StatusState.Attention" Text="@($"Expires in {SecondsLeft(approval)}")" />
                </div>
                <dl class="wm-dl">
                    <dt>App</dt>
                    <dd>@approval.ClientNameClaimed <span class="wm-muted">(the app names itself; Waymark cannot check it)</span></dd>
                    <dt>Returns to</dt>
                    <dd class="wm-mono">@approval.RedirectHost</dd>
                    <dt>Connects to</dt>
                    <dd class="wm-mono">@approval.Resource</dd>
                    <dt>Asked</dt>
                    <dd>@DisplayFormat.Ago(approval.RequestedUtc, Time.GetUtcNow())</dd>
                </dl>
                <div class="wm-actions wm-card-actions">
                    <WmButton Kind="ButtonKind.Danger" Disabled="_busy" OnClick="() => DecideAsync(approval, false)">Deny</WmButton>
                    <WmButton Kind="ButtonKind.Primary" Disabled="_busy" OnClick="() => DecideAsync(approval, true)">Approve</WmButton>
                </div>
            </section>
        }
    }

    <SectionHeader Title="Connected apps">
        <Actions>
            @if (HasDisconnected)
            {
                <WmButton Kind="ButtonKind.Danger" Small="true" Disabled="_busy" OnClick="ClearDisconnectedAsync" title="Removes disconnected apps only; active apps stay">Clear disconnected</WmButton>
            }
        </Actions>
    </SectionHeader>
    @if (_clients.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Link" Title="No apps registered" Text="An app appears here after it has asked to connect once." />
    }
    else
    {
        <div class="wm-table-wrap">
            <table class="wm-table">
                <caption class="visually-hidden">Apps that registered with Waymark</caption>
                <thead>
                    <tr><th scope="col">App</th><th scope="col">Returns to</th><th scope="col">Registered</th><th scope="col">Last used</th><th scope="col">State</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var client in _clients)
                    {
                        <tr>
                            <th scope="row">@client.ClientName</th>
                            <td class="wm-mono">@string.Join(", ", client.RedirectUris.Select(u => new Uri(u).Host).Distinct())</td>
                            <td>@DisplayFormat.Ago(client.RegisteredUtc, Time.GetUtcNow())</td>
                            <td>@DisplayFormat.Ago(client.LastUsedUtc, Time.GetUtcNow())</td>
                            <td><WmStatus State="@(client.IsRevoked ? StatusState.Off : StatusState.Healthy)" Text="@(client.IsRevoked ? "Disconnected" : "Active")" /></td>
                            <td class="num">
                                @if (!client.IsRevoked)
                                {
                                    <WmButton Kind="ButtonKind.Ghost" Small="true" Disabled="_busy" OnClick="() => RevokeAsync(client)">Disconnect</WmButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <SectionHeader Title="Recent decisions">
        <Actions>
            @if (HasClearableHistory)
            {
                <WmButton Kind="ButtonKind.Danger" Small="true" Disabled="_busy" OnClick="ClearHistoryAsync" title="Keeps waiting requests and approvals of active apps">Clear history</WmButton>
            }
        </Actions>
    </SectionHeader>
    @if (_history.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.History" Title="No decisions yet" />
    }
    else
    {
        <div class="wm-table-wrap">
            <table class="wm-table">
                <caption class="visually-hidden">The most recent pairing requests and what happened to them</caption>
                <thead>
                    <tr><th scope="col">When</th><th scope="col">Code</th><th scope="col">App</th><th scope="col">Returns to</th><th scope="col">Result</th></tr>
                </thead>
                <tbody>
                    @foreach (var approval in _history)
                    {
                        var state = HistoryState(approval);
                        <tr>
                            <td>@DisplayFormat.DateAndClock(approval.RequestedUtc)</td>
                            <td class="wm-mono">@DisplayFormat.PairingCode(approval.PairingCode)</td>
                            <td>@approval.ClientNameClaimed</td>
                            <td class="wm-mono">@approval.RedirectHost</td>
                            <td><WmStatus State="state.State" Text="@state.Text" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</PageFrame>
