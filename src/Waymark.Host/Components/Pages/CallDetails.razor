@page "/calls/{Id:long}"
@using Waymark.Host.Components.Shared

@* The full-page form of one call, for a link you want to keep or share. Everywhere else a call opens in the side panel (CallPanel). *@
<PageFrame Wide="true" Title="@($"Call #{Id}")" Back="@Back">
    <CallView Id="Id" />
</PageFrame>

@code {
    private static readonly PageFrame.PageBack Back = new("/audit", "Back to the audit");

    [Parameter]
    public long Id { get; set; }
}
