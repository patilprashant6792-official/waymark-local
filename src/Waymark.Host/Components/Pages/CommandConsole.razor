@page "/console/{RunId:long?}"
@inherits LiveComponentBase
@using Waymark.Core.Commands
@using Waymark.Host.Ui

<PageFrame Title="Console" Wide="true" Lead="Everything Claude runs on this computer shows up here as it happens. You can watch it and stop it; only Claude starts commands.">
    <Actions>
        <WmToggle Pressed="_followNew" Icon="@Icons.Material.Outlined.Bolt" OnClick="ToggleFollowAsync">@(_followNew ? "Following new commands" : "Follow new commands")</WmToggle>
    </Actions>
    <ChildContent>
    @if (_error is not null)
    {
        <InlineAlert Severity="Severity.Warning">@_error</InlineAlert>
    }

    @foreach (var waiting in _pending)
    {
        <CommandApprovalCard @key="waiting.Id" Run="waiting" OnDecided="OnDecidedAsync" />
    }

    <WmTabs Label="Where commands run" Tabs="TabList" Selected="@SelectedTab" SelectedChanged="OnTabChangedAsync" />

    <div class="wm-console">
        <nav class="wm-console-list" aria-label="Commands">
            <div class="wm-console-filter">
                <input class="wm-input" type="search" placeholder="Filter commands" aria-label="Filter commands" @bind="_runFilter" @bind:event="oninput" />
            </div>

            @if (TabRuns.Count == 0)
            {
                <div class="wm-console-empty">@(_runFilter.Trim().Length > 0 ? "No command matches the filter." : "Nothing has run here yet.")</div>
            }

            @foreach (var commandRun in TabRuns)
            {
                <a class="wm-run @(commandRun.Id == _selected?.Id ? "active" : "")" href="console/@commandRun.Id" aria-current="@(commandRun.Id == _selected?.Id ? "true" : null)">
                    <span class="wm-run-dot @DotClass(commandRun)" aria-hidden="true"></span>
                    <span class="wm-run-main">
                        <span class="wm-run-title">@Label(commandRun)</span>
                        <span class="wm-run-cmd wm-mono">@Short(commandRun.CommandLine)</span>
                        @if (commandRun.Purpose.Length > 0)
                        {
                            <span class="wm-run-why" title="@commandRun.Purpose">@commandRun.Purpose</span>
                        }
                    </span>
                    <span class="wm-run-when">@DisplayFormat.Ago(commandRun.RequestedUtc, Time.GetUtcNow())</span>
                </a>
            }
        </nav>

        <section class="wm-console-main" aria-label="Output">
            @if (_selected is not { } run)
            {
                <div class="wm-console-empty big">
                    <MudIcon Icon="@Icons.Material.Outlined.Computer" Size="Size.Large" />
                    <div>Pick a command on the left, or wait: the next one Claude starts appears here by itself.</div>
                </div>
            }
            else
            {
                <div class="wm-term-head">
                    <div class="wm-term-title">
                        <WmStatus State="Chip(run).State" Text="@Chip(run).Text" Live="@run.Status.IsActive()" />
                        <strong>@Label(run)</strong>
                        <span class="wm-muted">in @run.WorkspaceName</span>
                    </div>
                    <div class="wm-term-tools">
                        @if (run.Status.IsActive())
                        {
                            <WmButton Kind="ButtonKind.Danger" Small="true" Icon="@Icons.Material.Outlined.Stop" Disabled="_busy" OnClick="StopAsync">Stop</WmButton>
                        }

                        <WmButton Small="true" Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyOutputAsync">Copy output</WmButton>
                        <WmButton Kind="ButtonKind.Ghost" Small="true" Icon="@Icons.Material.Outlined.Code" OnClick="CopyCommandAsync">Copy command</WmButton>
                        <WmButton Kind="ButtonKind.Ghost" Small="true" Icon="@Icons.Material.Outlined.KeyboardDoubleArrowDown" OnClick="ToEndAsync">End</WmButton>
                    </div>
                </div>

                <div class="wm-term-meta">
                    <span>@Elapsed(run)</span>
                    @if (run.ExitCode is { } exit)
                    {
                        <span>exit code @exit</span>
                    }
                    <span>asked by @run.Actor @DisplayFormat.Ago(run.RequestedUtc, Time.GetUtcNow())</span>
                    @if (run.DecidedBy is not null)
                    {
                        <span>approved by you</span>
                    }
                    @if (run.Purpose.Length > 0)
                    {
                        <span class="wm-ellipsis" title="@run.Purpose">why: @run.Purpose</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(run.Note))
                {
                    <div class="wm-term-note">@run.Note</div>
                }

                @if (BannerText(run) is not null)
                {
                    <div class="wm-term-banner @BannerClass(run)" role="status">@BannerText(run)</div>
                }

                <div class="wm-term-bar" role="search" aria-label="Search this output">
                    <input id="wm-term-search" class="wm-input wm-term-search" type="search" placeholder="Search output  ( / )" aria-label="Search this output" @bind="_query" @bind:event="oninput" @bind:after="OnQueryChangedAsync" @onkeydown="OnSearchKeyAsync" />
                    <span class="wm-muted wm-term-count" aria-live="polite">@_findInfo</span>
                    <WmIconButton id="wm-term-prev" Icon="@Icons.Material.Outlined.KeyboardArrowUp" Label="Previous match" Disabled="@(_query.Trim().Length == 0)" OnClick="() => StepAsync(false)" />
                    <WmIconButton id="wm-term-next" Icon="@Icons.Material.Outlined.KeyboardArrowDown" Label="Next match" Disabled="@(_query.Trim().Length == 0)" OnClick="() => StepAsync(true)" />
                    <WmToggle id="wm-term-error" Icon="@Icons.Material.Outlined.ErrorOutline" OnClick="NextErrorAsync">Next error</WmToggle>
                    <WmToggle id="wm-term-wrap" Pressed="_wrap" OnClick="ToggleWrapAsync">Wrap lines</WmToggle>
                </div>

                <div id="wm-term" class="wm-term @(_wrap ? string.Empty : "nowrap")" tabindex="0" role="log" aria-label="Output of the command">
                    @if (_buffer.DroppedLines > 0)
                    {
                        <div class="wm-term-gap">@DisplayFormat.Count(_buffer.DroppedLines) earlier lines are not shown here. The whole output is stored with the run.</div>
                    }

                    @foreach (var block in _buffer.Blocks)
                    {
                        <ConsoleBlock @key="block.Id" Block="block" Buffer="_buffer" Version="block.Version" />
                    }

                    @if (run.Status == CommandRunStatus.WaitingApproval)
                    {
                        <div class="wm-term-wait">Waiting for your decision above. Nothing has run.</div>
                    }
                </div>
            }
        </section>
    </div>
    </ChildContent>
</PageFrame>
