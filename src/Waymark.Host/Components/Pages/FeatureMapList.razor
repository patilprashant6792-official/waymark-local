@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Memory
@using Waymark.Core.Transfer
@using Waymark.Host.Ui

<SectionHeader Title="Flows" Lead="When Claude traces a feature of this workspace it saves the path as a flow: the methods from the trigger to the outcome, in call order, under the feature's name, so the next session reads the path in one call and opens only the methods it needs. A flow holds names only, never code, and it follows you across branches: a step that is not in the code that is checked out is marked and kept, not deleted. Claude creates and changes the flows; here you read them, check them against the code, and remove what is wrong.">
    <Actions>
        <BundleToolbar WorkspaceId="Workspace.Id" Content="BundleContent.FeatureMaps" ExportLabel="Export flows" Hint="Keep your flows when you move to another computer." />
    </Actions>
</SectionHeader>

@if (_error is not null)
{
    <InlineAlert Severity="Severity.Warning">@_error</InlineAlert>
}

@if (!_loaded)
{
    <p class="wm-lead" aria-live="polite">Loading...</p>
}
else
{
    <section class="wm-card" aria-labelledby="fm-find">
        <h2 id="fm-find" class="wm-card-title">Find</h2>
        <div class="wm-row">
            <WmTextField Label="Search" @bind-Value="_query" Immediate="true" Width="FieldWidth.Large" HelperText="Words in a name, summary, path, method or note" MaxLength="200" OnKeyUp="OnSearchKey" />
            <WmButton OnClick="SearchAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_query))">Search</WmButton>
            @if (_searchedFor.Length > 0)
            {
                <WmButton Kind="ButtonKind.Ghost" OnClick="ShowAllAsync" Disabled="_busy">Show all</WmButton>
            }
            <WmButton OnClick="CheckAsync" Disabled="@(_busy || _maps.Count == 0)">Check against the code</WmButton>
        </div>
        <p class="wm-muted wm-caption" aria-live="polite">@Caption()</p>
    </section>

    @if (_maps.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.AccountTree" Title="@(_searchedFor.Length > 0 ? "No flow matches" : "No flows yet")" Text="@(_searchedFor.Length > 0 ? "Try other words, or show all." : "After Claude traces a feature it saves one with memorise, and it appears here at once.")" />
    }
    else
    {
        foreach (var map in _maps)
        {
            var missing = MissingCount(map);
            var broken = BrokenCount(map);
            <div @key="map.Id" class="wm-stack-item">
                <CollapsibleSection Id="@($"fm-{map.Id}")" Title="@map.Name" InitiallyExpanded="@(_maps.Count == 1)">
                    <Summary>
                        <WmTag Text="@($"{map.Steps.Count} {(map.Steps.Count == 1 ? "step" : "steps")}")" />
                        <WmTag Text="@($"v{map.Version}")" Title="Goes up every time the flow is saved" />
                        @if (!map.Ordered)
                        {
                            <WmTag Tone="Tone.Warn" Text="unordered" Title="Saved before flows existed: a plain list of components. Claude puts the steps in call order the next time it uses the flow." />
                        }
                        @if (missing > 0)
                        {
                            <WmTag Tone="Tone.Warn" Text="@($"{missing} not on this branch")" Title="Kept in memory, but not in the code that is checked out" />
                        }
                        @if (broken > 0)
                        {
                            <WmTag Tone="Tone.Error" Text="@($"{broken} {(broken == 1 ? "link does" : "links do")} not call")" Title="Both steps are in the code, and the step above makes no such call" />
                        }
                        <span class="wm-muted">Updated @DisplayFormat.Ago(map.UpdatedUtc, Time.GetUtcNow())</span>
                    </Summary>
                    <ChildContent>
                        @if (map.Summary.Length > 0)
                        {
                            <p>@map.Summary</p>
                        }
                        @if (map.DistinctReason.Length > 0)
                        {
                            <p class="wm-muted">Kept next to another flow with the same trigger: @map.DistinctReason</p>
                        }
                        <div class="wm-table-wrap">
                            <table class="wm-table">
                                <caption class="visually-hidden">Steps of the flow @map.Name</caption>
                                <thead>
                                    <tr><th scope="col">Step</th><th scope="col">Note</th><th scope="col">In the code now</th><th scope="col">Link from the step above</th><th scope="col">Actions</th></tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < map.Steps.Count; i++)
                                    {
                                        var index = i;
                                        var step = map.Steps[i];
                                        var status = StatusOf(map, i);
                                        var link = LinkChip(status);
                                        var whyNot = WhyNotRemovable(map, i);
                                        var (stepPath, stepMember) = SplitSpec(step.Spec);
                                        <tr>
                                            <th scope="row" class="wm-flow-step @IndentClass(step)">
                                                @if (stepMember is not null)
                                                {
                                                    <span class="wm-flow-member wm-mono">@stepMember</span>
                                                }
                                                <span class="wm-mono @(stepMember is null ? "wm-flow-member" : "wm-flow-path")">@stepPath</span>
                                            </th>
                                            <td class="wm-flow-note">@step.Note</td>
                                            <td class="wm-flow-state">
                                                @if (status is null)
                                                {
                                                    <span class="wm-muted">Not checked</span>
                                                }
                                                else if (status.Available)
                                                {
                                                    <WmStatus State="StatusState.Healthy" Text="Here" />
                                                }
                                                else
                                                {
                                                    <WmStatus State="StatusState.Attention" Text="Not on this branch" Title="@status.Problem" />
                                                    @if (status.MovedTo is not null)
                                                    {
                                                        <span class="wm-muted wm-mono" title="A method of this name is in another file">moved? @status.MovedTo</span>
                                                    }
                                                }
                                            </td>
                                            <td class="wm-flow-state">
                                                @if (link is { } chip)
                                                {
                                                    <WmStatus State="chip.State" Text="@chip.Text" Title="@chip.Title" />
                                                }
                                                else if (i == 0 && map.Ordered)
                                                {
                                                    <span class="wm-muted">Trigger</span>
                                                }
                                            </td>
                                            <td class="wm-flow-state"><WmButton Kind="ButtonKind.Danger" Small="true" Disabled="@(_busy || whyNot is not null)" title="@whyNot" OnClick="() => RemoveStepAsync(map, index)">Remove</WmButton></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="wm-row wm-card-actions">
                            <CopyButton Text="@StepsText(map)" Label="Copy steps" />
                            <WmButton Kind="ButtonKind.Danger" Disabled="_busy" OnClick="() => DeleteMapAsync(map)">Delete flow</WmButton>
                        </div>
                    </ChildContent>
                </CollapsibleSection>
            </div>
        }
    }
}
