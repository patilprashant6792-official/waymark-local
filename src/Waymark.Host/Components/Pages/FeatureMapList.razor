@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Memory
@using Waymark.Core.Transfer
@using Waymark.Host.FeatureMaps
@using Waymark.Host.Ui

<SectionHeader Title="Flows" Lead="When an agent traces a feature of this workspace it saves the path as a flow: the methods from the trigger to the outcome, in call order, under the feature's name, so the next session reads the path in one call and opens only the methods it needs. A flow holds names only, never code, and it follows you across branches: a step that is not in the code that is checked out is marked and kept, not deleted. Agents create and change the flows; here you read them, see when an agent last used each one, check them against the code, and remove what is wrong.">
    <Actions>
        <BundleToolbar WorkspaceId="Workspace.Id" Content="BundleContent.FeatureMaps" ExportLabel="Export flows" Hint="Keep your flows when you move to another computer." />
    </Actions>
</SectionHeader>

@if (_error is not null)
{
    <InlineAlert Severity="Severity.Warning">@_error</InlineAlert>
}

@if (!_loaded)
{
    <p class="wm-lead" aria-live="polite">Loading...</p>
}
else
{
    <section class="wm-card" aria-labelledby="fm-find">
        <h2 id="fm-find" class="wm-card-title">Find</h2>
        <div class="wm-row">
            <WmTextField Label="Search" @bind-Value="_query" Immediate="true" Width="FieldWidth.Large" HelperText="Words in a name, summary, path, method or note" MaxLength="200" OnKeyUp="OnSearchKey" />
            <WmSelect TValue="MemoryOrder" Label="Order" Options="OrderOptions" Value="_order" ValueChanged="ChangeOrderAsync" Width="FieldWidth.Small" />
            <WmButton OnClick="SearchAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_query))">Search</WmButton>
            @if (_searchedFor.Length > 0)
            {
                <WmButton Kind="ButtonKind.Ghost" OnClick="ShowAllAsync" Disabled="_busy">Show all</WmButton>
            }
            <WmButton OnClick="CheckAsync" Disabled="@(_busy || _maps.Count == 0)">Check against the code</WmButton>
        </div>
        <p class="wm-muted wm-caption" aria-live="polite">@Caption()</p>
    </section>

    @if (_maps.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.AccountTree" Title="@(_searchedFor.Length > 0 ? "No flow matches" : "No flows yet")" Text="@(_searchedFor.Length > 0 ? "Try other words, or show all." : "After Claude traces a feature it saves one with memory_save, and it appears here at once.")" />
    }
    else
    {
        foreach (var map in _maps)
        {
            var missing = MissingCount(map) ?? 0;
            var broken = BrokenCount(map) ?? 0;
            var shownSteps = StepsShownOf(map);
            <div @key="map.Id" class="wm-stack-item">
                <CollapsibleSection Id="@($"fm-{map.Id}")" Title="@map.Name" InitiallyExpanded="@(_maps.Count == 1)" RenderWhenCollapsed="false" OnToggled="expanded => OnToggledAsync(map, expanded)">
                    <Summary>
                        <WmTag Text="@($"{map.Steps.Count} {(map.Steps.Count == 1 ? "step" : "steps")}")" />
                        <WmTag Text="@($"v{map.Version}")" Title="Goes up every time the flow is saved" />
                        @if (!map.Ordered)
                        {
                            <WmTag Tone="Tone.Warn" Text="unordered" Title="Saved before flows existed: a plain list of components. An agent puts the steps in call order the next time it uses the flow." />
                        }
                        @if (missing > 0)
                        {
                            <WmTag Tone="Tone.Warn" Text="@($"{missing} not on this branch")" Title="Kept in memory, but not in the code that is checked out" />
                        }
                        @if (broken > 0)
                        {
                            <WmTag Tone="Tone.Error" Text="@($"{broken} {(broken == 1 ? "link does" : "links do")} not call")" Title="Both steps are in the code, and the step above makes no such call" />
                        }
                        @{ var noteCount = NotesOf(map).Count; var staleCount = NotesOf(map).Count(n => NoteStalenessOf(n) is { MayBeStale: true }); var orphanCount = OrphanNotes(map).Count; }
                        @if (noteCount > 0)
                        {
                            <WmTag Text="@($"{noteCount} {(noteCount == 1 ? "note" : "notes")}")" Title="Notes on this flow and its steps" />
                        }
                        @if (staleCount > 0)
                        {
                            <WmTag Tone="Tone.Warn" Text="@($"{staleCount} may be stale")" Title="The code or the flow changed since these notes were written or confirmed" />
                        }
                        @if (orphanCount > 0)
                        {
                            <WmTag Tone="Tone.Warn" Text="@($"{orphanCount} detached")" Title="Notes on steps that are no longer in this flow" />
                        }
                        @if (!_checking && !_status.ContainsKey(map.Id))
                        {
                            <WmTag Text="not checked" Title="Open the flow, or use 'Check against the code', to check its steps" />
                        }
                        <span class="wm-muted">Updated @DisplayFormat.Ago(map.UpdatedUtc, Time.GetUtcNow())</span>
                        <span class="wm-muted" title="@LastUsedTitle(map)">· Last used @DisplayFormat.Ago(LastUsedOf(map), Time.GetUtcNow())</span>
                    </Summary>
                    <ChildContent>
                        @if (map.Summary.Length > 0)
                        {
                            <p>@map.Summary</p>
                        }
                        @if (map.DistinctReason.Length > 0)
                        {
                            <p class="wm-muted">Kept next to another flow with the same trigger: @map.DistinctReason</p>
                        }
                        @if (_historyOf is { } historyId && NotesOf(map).Any(n => n.Id == historyId))
                        {
                            <NoteHistory NoteId="historyId" Revisions="_history" OnClose="() => _historyOf = null" />
                        }
                        <div class="wm-stack" aria-label="@($"Notes on the flow {map.Name}")">
                            @foreach (var note in FlowNotes(map))
                            {
                                <NoteRow @key="note.Id" Note="note" Staleness="NoteStalenessOf(note)" Busy="_busy"
                                         OnEdit="StartEditNote" OnRetire="RetireNoteAsync" OnConfirm="ConfirmNoteAsync" OnPin="TogglePinAsync" OnHistory="ShowHistoryAsync" />
                            }
                            @if (IsEditorFor(map, null))
                            {
                                <NoteEditor Title="@EditorTitle(map, null)" Editing="_editingNote" Busy="_busy" Error="@_noteError" OnSave="v => SaveNoteAsync(map, null, v)" OnCancel="CloseNoteEditor" />
                            }
                            else
                            {
                                <div><WmButton Small="true" Kind="ButtonKind.Ghost" Icon="@Icons.Material.Outlined.Add" Disabled="_busy" OnClick="() => StartAddNote(map, null)">Note on this flow</WmButton></div>
                            }
                        </div>
                        <div class="wm-table-wrap">
                            <table class="wm-table">
                                <caption class="visually-hidden">Steps of the flow @map.Name</caption>
                                <thead>
                                    <tr><th scope="col">Step</th><th scope="col">Label</th><th scope="col">In the code now</th><th scope="col">Link from the step above</th><th scope="col">Actions</th></tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < shownSteps; i++)
                                    {
                                        var index = i;
                                        var step = map.Steps[i];
                                        var status = StatusOf(map, i);
                                        var link = LinkChip(status);
                                        var whyNot = WhyNotRemovable(map, i);
                                        var (stepPath, stepMember) = SplitSpec(step.Spec);
                                        <tr>
                                            <th scope="row" class="wm-flow-step @IndentClass(step)">
                                                @if (stepMember is not null)
                                                {
                                                    <span class="wm-flow-member wm-mono">@stepMember</span>
                                                }
                                                <span class="wm-mono @(stepMember is null ? "wm-flow-member" : "wm-flow-path")">@stepPath</span>
                                            </th>
                                            <td class="wm-flow-note">@step.Note</td>
                                            <td class="wm-flow-state">
                                                @if (status is null)
                                                {
                                                    <span class="wm-muted">Not checked</span>
                                                }
                                                else if (status.Available)
                                                {
                                                    <WmStatus State="StatusState.Healthy" Text="Here" />
                                                }
                                                else
                                                {
                                                    <WmStatus State="StatusState.Attention" Text="Not on this branch" Title="@status.Problem" />
                                                    @if (status.MovedTo is not null)
                                                    {
                                                        <span class="wm-muted wm-mono" title="A method of this name is in another file">moved? @status.MovedTo</span>
                                                    }
                                                }
                                            </td>
                                            <td class="wm-flow-state">
                                                @if (link is { } chip)
                                                {
                                                    <WmStatus State="chip.State" Text="@chip.Text" Title="@chip.Title" />
                                                }
                                                else if (i == 0 && map.Ordered)
                                                {
                                                    <span class="wm-muted">Trigger</span>
                                                }
                                            </td>
                                            <td class="wm-flow-state">
                                                <WmButton Kind="ButtonKind.Ghost" Small="true" Disabled="_busy" OnClick="() => StartAddNote(map, step.Spec)" aria-label="@($"Add a note to step {i + 1}")">+ Note</WmButton>
                                                <WmButton Kind="ButtonKind.Danger" Small="true" Disabled="@(_busy || whyNot is not null)" title="@whyNot" OnClick="() => RemoveStepAsync(map, index)">Remove</WmButton>
                                            </td>
                                        </tr>
                                        var stepNotes = StepNotes(map, step.Spec);
                                        if (stepNotes.Count > 0 || IsEditorFor(map, step.Spec))
                                        {
                                            <tr class="wm-flow-notes">
                                                <td colspan="5" class="@IndentClass(step)">
                                                    @foreach (var note in stepNotes)
                                                    {
                                                        <NoteRow @key="note.Id" Note="note" Staleness="NoteStalenessOf(note)" Busy="_busy" ShowLastUsed="false"
                                                                 OnEdit="StartEditNote" OnRetire="RetireNoteAsync" OnConfirm="ConfirmNoteAsync" OnPin="TogglePinAsync" OnHistory="ShowHistoryAsync" />
                                                    }
                                                    @if (IsEditorFor(map, step.Spec))
                                                    {
                                                        var spec = step.Spec;
                                                        <NoteEditor Title="@EditorTitle(map, spec)" Editing="_editingNote" Busy="_busy" Error="@_noteError" OnSave="v => SaveNoteAsync(map, spec, v)" OnCancel="CloseNoteEditor" />
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (shownSteps < map.Steps.Count)
                        {
                            <div class="wm-row">
                                <WmButton Kind="ButtonKind.Ghost" Small="true" OnClick="() => ShowMoreSteps(map)">Show the next @Math.Min(StepChunk, map.Steps.Count - shownSteps) steps (@shownSteps of @map.Steps.Count shown)</WmButton>
                            </div>
                        }
                        @if (OrphanNotes(map).Count > 0)
                        {
                            <h3 class="wm-card-title">Notes on steps no longer in this flow</h3>
                            <div class="wm-stack">
                                @foreach (var note in OrphanNotes(map))
                                {
                                    <NoteRow @key="note.Id" Note="note" Staleness="NoteStalenessOf(note)" Busy="_busy" ShowAnchor="true" ShowLastUsed="false"
                                             OnEdit="StartEditNote" OnRetire="RetireNoteAsync" OnConfirm="ConfirmNoteAsync" OnPin="TogglePinAsync" OnHistory="ShowHistoryAsync" />
                                }
                            </div>
                        }
                        <div class="wm-row wm-card-actions">
                            <CopyButton Text="@StepsText(map)" Label="Copy steps" />
                            <WmButton Kind="ButtonKind.Danger" Disabled="_busy" OnClick="() => DeleteMapAsync(map)">Delete flow</WmButton>
                        </div>
                    </ChildContent>
                </CollapsibleSection>
            </div>
        }
        if (_total > FeatureMapAdminService.PageSize)
        {
            <nav class="wm-row" aria-label="Pages of flows">
                <WmButton Kind="ButtonKind.Ghost" Disabled="@(_busy || _page == 0)" OnClick="() => GoToPageAsync(_page - 1)">Previous</WmButton>
                <span class="wm-muted wm-caption">Page @(_page + 1) of @Pages</span>
                <WmButton Kind="ButtonKind.Ghost" Disabled="@(_busy || _page + 1 >= Pages)" OnClick="() => GoToPageAsync(_page + 1)">Next</WmButton>
            </nav>
        }
    }
}
