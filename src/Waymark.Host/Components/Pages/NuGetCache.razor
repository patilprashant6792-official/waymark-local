@page "/packages"
@page "/nuget"
@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.NuGetIndex
@using Waymark.Host.Components.Shared
@using Waymark.Host.NuGetAdmin
@using Waymark.Host.Ui

<PageFrame Wide="true" Title="Packages" Lead="Every NuGet, PyPI and npm package Claude has looked up. Waymark keeps a searchable index of each one and the result of reading it, so the next lookup is instant. NuGet packages are read from the shared NuGet folder of this computer, the one dotnet uses, and Waymark never deletes from it. PyPI and npm packages are downloaded to a temporary folder, checked against the registry's hash, read by syntax only, and deleted again; nothing is installed or run. If a package misbehaves, reload it (reads it again) or clear it (it is fetched afresh the next time it is asked for).">
    @if (_error is not null)
    {
        <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
    }

    @if (_overview is null)
    {
        <p class="wm-muted" aria-live="polite">Loading...</p>
    }
    else
    {
        var stats = _overview.Stats;
        <section class="wm-kpis" aria-label="Package statistics">
            <div class="wm-kpi"><div class="wm-kpi-label">Ready</div><div class="wm-kpi-value">@DisplayFormat.Count(stats.Ready)</div><div class="wm-kpi-sub">packages searchable@(stats.Building > 0 ? $", {stats.Building} building" : string.Empty)</div></div>
            <div class="wm-kpi @(stats.Failed > 0 ? "bad" : string.Empty)"><div class="wm-kpi-label">Failed</div><div class="wm-kpi-value">@DisplayFormat.Count(stats.Failed)</div><div class="wm-kpi-sub">@(stats.Failed > 0 ? "need a reload or a clear" : "none")</div></div>
            <div class="wm-kpi"><div class="wm-kpi-label">Types</div><div class="wm-kpi-value">@DisplayFormat.Count(stats.Types)</div><div class="wm-kpi-sub">@DisplayFormat.Count(stats.Symbols) symbols</div></div>
            <div class="wm-kpi"><div class="wm-kpi-label">Index size</div><div class="wm-kpi-value">@DisplayFormat.Size(stats.IndexBytes)</div><div class="wm-kpi-sub">symbol text, approximate</div></div>
            <div class="wm-kpi"><div class="wm-kpi-label">Stored results</div><div class="wm-kpi-value">@DisplayFormat.Count(stats.CachedResults)</div><div class="wm-kpi-sub">@DisplayFormat.Size(stats.CachedBytes)</div></div>
            <div class="wm-kpi"><div class="wm-kpi-label">Last indexed</div><div class="wm-kpi-value">@DisplayFormat.Ago(stats.LastIndexedUtc, Time.GetUtcNow())</div><div class="wm-kpi-sub">&nbsp;</div></div>
        </section>

        <div class="wm-row">
            <WmTextField Label="Filter by package" @bind-Value="_filter" Immediate="true" />
            <label class="visually-hidden" for="pkg-ecosystem">Ecosystem</label>
            <select id="pkg-ecosystem" class="wm-select" value="@_ecosystem" @onchange="e => _ecosystem = e.Value?.ToString() ?? string.Empty">
                <option value="">All ecosystems (@_overview.Entries.Count)</option>
                <option value="@PackageEcosystems.NuGet">NuGet - .NET (@CountOf(PackageEcosystems.NuGet))</option>
                <option value="@PackageEcosystems.PyPI">PyPI - Python (@CountOf(PackageEcosystems.PyPI))</option>
                <option value="@PackageEcosystems.Npm">npm - JavaScript and TypeScript (@CountOf(PackageEcosystems.Npm))</option>
            </select>
            <WmButton Disabled="_busy" OnClick="LoadAsync">Refresh</WmButton>
            <WmButton Disabled="@(_busy || stats.Failed == 0)" OnClick="ReloadFailedAsync">Reload failed</WmButton>
            <WmButton Kind="ButtonKind.Danger" Disabled="@(_busy || stats.Failed == 0)" OnClick="ClearFailedAsync">Clear failed</WmButton>
            <WmButton Kind="ButtonKind.Danger" Disabled="@(_busy || (_overview.Entries.Count == 0 && _overview.OtherResults.Count == 0))" OnClick="ClearAllAsync">Clear everything</WmButton>
        </div>
        @if (_busy && _status is not null)
        {
            <p class="wm-muted" aria-live="polite">@_status</p>
        }

        <SectionHeader Title="Indexed packages" />
        @if (_overview.Entries.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Inventory" Title="Nothing indexed yet" Text="A package appears here the first time Claude looks it up with the pkg tools (NuGet, PyPI or npm)." />
        }
        else if (Visible.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Search" Title="No match" Text="No indexed package matches the filter." />
        }
        else
        {
            <div class="wm-table-wrap">
                <table class="wm-table">
                    <caption class="visually-hidden">Indexed packages with their ecosystem, size and state</caption>
                    <thead>
                        <tr><th scope="col">Package</th><th scope="col">Target</th><th scope="col">State</th><th scope="col">Types</th><th scope="col">Symbols</th><th scope="col">Index</th><th scope="col">Stored results</th><th scope="col">Indexed</th><th scope="col">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Visible)
                        {
                            var package = entry.Package;
                            var state = StateOf(entry);
                            <tr>
                                <th scope="row">
                                    <div>@package.Key.PackageId <span class="wm-muted wm-mono">@package.Key.Version</span></div>
                                    <div class="wm-muted">@NuGetLinks.EcosystemLabel(package.Key)</div>
                                    @if (entry.ExtraPackageIds.Count > 0)
                                    {
                                        <div class="wm-muted">read together with @string.Join(", ", entry.ExtraPackageIds)</div>
                                    }
                                    @if (!string.IsNullOrEmpty(package.Error))
                                    {
                                        <div class="wm-muted">@package.Error</div>
                                    }
                                </th>
                                <td class="wm-mono">@(PackageEcosystems.Of(package.Key) == PackageEcosystems.NuGet ? package.Key.TargetFramework : "-")</td>
                                <td><WmStatus State="state.State" Text="@state.Text" /></td>
                                <td>@DisplayFormat.Count(package.TypeCount)</td>
                                <td>@DisplayFormat.Count(package.SymbolCount)</td>
                                <td>@DisplayFormat.Size(entry.IndexBytes)</td>
                                <td>@DisplayFormat.Count(entry.CachedResults) <span class="wm-muted">(@DisplayFormat.Size(entry.CachedBytes))</span></td>
                                <td>@DisplayFormat.Ago(package.IndexedUtc ?? package.StartedUtc, Time.GetUtcNow())</td>
                                <td>
                                    <div class="wm-actions">
                                        <WmButton Kind="ButtonKind.Primary" Small="true" Href="@NuGetLinks.Explore(package.Key)" Disabled="@(package.State != NuGetIndexState.Ready)">Explore</WmButton>
                                        <WmButton Small="true" Disabled="@(_busy || package.State == NuGetIndexState.Building)" OnClick="() => ReloadAsync(entry)">Reload</WmButton>
                                        <WmButton Kind="ButtonKind.Danger" Small="true" Disabled="_busy" OnClick="() => ClearAsync(entry)">Clear</WmButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_overview.OtherResults.Count > 0)
        {
            <SectionHeader Title="Other stored results" Lead="Results of reading a package that have no index of their own: the shortcut for &quot;latest&quot;, or a package whose index failed or was cleared." />
            <div class="wm-table-wrap">
                <table class="wm-table">
                    <caption class="visually-hidden">Stored results without an index</caption>
                    <thead>
                        <tr><th scope="col">Key</th><th scope="col">Version</th><th scope="col">Size</th><th scope="col">Stored</th><th scope="col">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var result in _overview.OtherResults)
                        {
                            <tr>
                                <th scope="row" class="wm-mono">@result.CacheKey</th>
                                <td class="wm-mono">@result.ResolvedVersion</td>
                                <td>@DisplayFormat.Size(result.Bytes)</td>
                                <td>@DisplayFormat.Ago(result.StoredUtc, Time.GetUtcNow())</td>
                                <td><WmButton Kind="ButtonKind.Danger" Small="true" Disabled="_busy" OnClick="() => RemoveResultAsync(result)">Remove</WmButton></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</PageFrame>
