@page "/tools"
@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Tools
@using Waymark.Host.Components.Shared
@using Waymark.Host.Ui

<PageTitle>Tools - Waymark</PageTitle>

<div class="wm-page">
    <h1 class="wm-title">Tools</h1>
    <p class="wm-lead">Choose what Claude can do here. Every tool you leave on adds its description to every conversation, so fewer tools means more room for your work.</p>

    @if (_error is not null)
    {
        <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
    }

    <section class="wm-card" aria-labelledby="tools-profile">
        <div class="wm-row spread">
            <h2 id="tools-profile" class="wm-section" style="margin:0">Profile</h2>
            <div class="wm-row">
                @if (CurrentProfile == "custom")
                {
                    <StateChip State="StatusState.Attention" Text="Custom" />
                }
                <span class="wm-chip info">Applies on reconnect</span>
            </div>
        </div>
        <div class="wm-seg" role="radiogroup" aria-label="Tool profile">
            <button type="button" role="radio" aria-checked="@(CurrentProfile == "readonly" ? "true" : "false")" class="@(CurrentProfile == "readonly" ? "on" : null)" disabled="@_busy" @onclick='() => ApplyProfileAsync("readonly")'>Read-only</button>
            <button type="button" role="radio" aria-checked="@(CurrentProfile == "edit" ? "true" : "false")" class="@(CurrentProfile == "edit" ? "on" : null)" disabled="@_busy" @onclick='() => ApplyProfileAsync("edit")'>Edit</button>
            <button type="button" role="radio" aria-checked="@(CurrentProfile == "full" ? "true" : "false")" class="@(CurrentProfile == "full" ? "on" : null)" disabled="@_busy" @onclick='() => ApplyProfileAsync("full")'>Full</button>
        </div>
        <p class="wm-muted" style="margin:8px 0">Read-only can look but not change. Edit adds creating, editing and moving files. Full also allows deleting.</p>

        <div aria-live="polite">
            <strong>@EnabledCount of @_rows.Count tools on</strong>
            <span class="wm-muted"> &middot; about @DisplayFormat.Count(EnabledTokens) of @DisplayFormat.Count(TotalTokens) tokens (a rough guess: text length divided by four)</span>
        </div>
        <MudProgressLinear Value="@(TotalTokens == 0 ? 0 : 100d * EnabledTokens / TotalTokens)" Color="Color.Primary" Class="mt-2" aria-label="Share of tool descriptions switched on" />
    </section>

    @if (_rows.Count > 0)
    {
        <div class="wm-filter-bar" role="search" aria-label="Filter tools">
            <input id="tools-search" class="wm-input wm-filter-search" type="search" placeholder="Filter tools by name or module  ( / )" aria-label="Filter tools" @bind="_search" @bind:event="oninput" />
            <label class="wm-filter-field">Kind
                <select class="wm-select" @bind="_kind">
                    <option value="all">All kinds</option>
                    <option value="read">Read only</option>
                    <option value="confirm">Needs confirmation</option>
                </select>
            </label>
            <label class="wm-filter-field">State
                <select class="wm-select" @bind="_state">
                    <option value="all">On and off</option>
                    <option value="on">On</option>
                    <option value="off">Off</option>
                </select>
            </label>
            <span class="wm-muted" aria-live="polite">Showing @VisibleCount of @_rows.Count</span>
        </div>
    }

    @if (_rows.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Build" Title="No tools registered" Text="The modules did not register any tools. Check the log." />
    }

    @foreach (var group in Groups)
    {
        <h2 class="wm-section" style="margin-top:24px;text-transform:capitalize">@group.Key</h2>
        <div class="wm-table-wrap">
            <table class="wm-table">
                <caption class="visually-hidden">@group.Key tools</caption>
                <thead>
                    <tr><th scope="col">On</th><th scope="col">Tool</th><th scope="col">Kind</th><th scope="col" class="num">Tokens</th><th scope="col">Last used</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in group)
                    {
                        <tr>
                            <td><MudSwitch T="bool" Value="row.Enabled" ValueChanged="v => ToggleAsync(row, v)" Disabled="_busy" Color="Color.Primary" aria-label="@($"Switch {row.Tool.Name}")" /></td>
                            <th scope="row" class="wm-mono">@row.Tool.Name</th>
                            <td>
                                @if (row.Tool.Gate == ToolGate.Confirm)
                                {
                                    <StateChip State="StatusState.Attention" Text="Needs confirmation" />
                                }
                                else
                                {
                                    <StateChip State="StatusState.Healthy" Text="Read only" />
                                }
                            </td>
                            <td class="num">@DisplayFormat.Count(row.Tokens)</td>
                            <td>@DisplayFormat.Ago(row.LastUsedUtc, Time.GetUtcNow())</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_rows.Count > 0 && VisibleCount == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Search" Title="No tool matches" Text="Clear the filter to see every tool again." />
    }
</div>
