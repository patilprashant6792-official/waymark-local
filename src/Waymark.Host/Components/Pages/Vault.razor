@page "/vault"
@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Vault
@using Waymark.Host.Components.Shared
@using Waymark.Host.Ui

@* Hidden from the menu for now (see NavCatalog), but the page and its address stay. *@
<PageFrame Title="Vault">
    <LeadContent>
        <p class="wm-lead">Secrets such as tokens and passwords, kept encrypted on this computer. Claude refers to a secret by name and never sees its value; if a value shows up in a tool result, it is replaced with its name before the result leaves this machine. See <a href="safety">Safety</a>.</p>
    </LeadContent>
    <ChildContent>
        @if (_error is not null)
        {
            <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
        }

        <section class="wm-card" aria-labelledby="vault-add">
            <h2 id="vault-add" class="wm-card-title">Add or replace a secret</h2>
            <div class="wm-row">
                <WmTextField Label="Name" @bind-Value="_name" HelperText="For example GITHUB_TOKEN" />
                <WmTextField Label="Value" @bind-Value="_value" InputType="InputType.Password" Width="FieldWidth.Large" HelperText="Shown once here, never again" />
                <WmButton Kind="ButtonKind.Primary" OnClick="SaveAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrEmpty(_value))">Save secret</WmButton>
            </div>
        </section>

        <SectionHeader Title="Saved secrets" />
        @if (_secrets.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="No secrets yet" Text="Add one above. Values are encrypted with keys only your account on this computer can open (Windows data protection, or the macOS login Keychain) and cannot be read back." />
        }
        else
        {
            <div class="wm-table-wrap">
                <table class="wm-table">
                    <caption class="visually-hidden">Saved secrets. Values are never shown.</caption>
                    <thead>
                        <tr><th scope="col">Name</th><th scope="col">Ends in</th><th scope="col">Updated</th><th scope="col">Last used</th><th scope="col">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var secret in _secrets)
                        {
                            <tr>
                                <th scope="row" class="wm-mono">@secret.Name</th>
                                <td class="wm-mono">@(secret.Hint.Length == 0 ? "hidden" : secret.Hint)</td>
                                <td>@DisplayFormat.Ago(secret.UpdatedUtc, Time.GetUtcNow())</td>
                                <td>@DisplayFormat.Ago(secret.LastUsedUtc, Time.GetUtcNow())</td>
                                <td>
                                    <div class="wm-actions">
                                        <WmButton Small="true" OnClick="() => Replace(secret)">Replace</WmButton>
                                        <WmButton Kind="ButtonKind.Danger" Small="true" OnClick="() => DeleteAsync(secret)">Delete</WmButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</PageFrame>
