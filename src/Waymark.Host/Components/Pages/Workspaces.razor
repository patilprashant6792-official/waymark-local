@page "/workspaces"
@inherits LiveComponentBase
@using Waymark.Host.Ui
@using Waymark.Core.Transfer

<PageFrame Title="Workspaces" Lead="Folders Claude may read and, when you allow it, change. Nothing outside these folders is reachable. Open a workspace to set its access rules and other options.">
    <Actions>
        <BundleToolbar Content="BundleContent.All" ExportLabel="Export all" />
        <WmButton Kind="ButtonKind.Primary" Icon="@Icons.Material.Outlined.Add" OnClick="AddAsync">Add workspace</WmButton>
    </Actions>
    <ChildContent>
        @if (_error is not null)
        {
            <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
        }

        @if (!_loaded)
        {
            <p class="wm-lead" aria-live="polite">Loading...</p>
        }
        else if (_items.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.FolderOpen" Title="No workspaces yet" Text="Add a folder. Waymark indexes it so Claude can search it quickly.">
                <div class="wm-actions wm-card-actions">
                    <WmButton Kind="ButtonKind.Primary" Icon="@Icons.Material.Outlined.Add" OnClick="AddAsync">Add workspace</WmButton>
                </div>
            </EmptyState>
        }
        else
        {
            <ul class="wm-tiles wm-ws-grid" aria-label="Workspaces">
                @foreach (var item in _items)
                {
                    <li @key="item.Id">
                        <WorkspaceCard Workspace="item" Stats="_stats.GetValueOrDefault(item.Id)" Progress="_progress.GetValueOrDefault(item.Id)" Repo="_repos.GetValueOrDefault(item.Id)" ShownPath="@ShownPath(item.Path)" Now="Time.GetUtcNow()" />
                    </li>
                }
            </ul>
        }
    </ChildContent>
</PageFrame>
