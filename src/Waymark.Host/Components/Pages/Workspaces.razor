@page "/workspaces"
@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Host.Components.Shared
@using Waymark.Host.Ui

<PageTitle>Workspaces - Waymark</PageTitle>

<div class="wm-page">
    <div class="wm-page-head">
        <div>
            <h1 class="wm-title">Workspaces</h1>
            <p class="wm-lead">Folders Claude may read and, when you allow it, change. Nothing outside these folders is reachable. Open a workspace to set its access rules and other options.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add workspace</MudButton>
    </div>

    @if (_error is not null)
    {
        <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
    }

    @if (!_loaded)
    {
        <p class="wm-lead" aria-live="polite">Loading...</p>
    }
    else if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.FolderOpen" Title="No workspaces yet" Text="Add a folder. Waymark indexes it so Claude can search it quickly.">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync" Style="margin-top:12px">Add workspace</MudButton>
        </EmptyState>
    }
    else
    {
        <ul class="wm-tiles wm-ws-grid" aria-label="Workspaces">
            @foreach (var item in _items)
            {
                <li @key="item.Id">
                    <WorkspaceCard Workspace="item" Stats="_stats.GetValueOrDefault(item.Id)" Progress="_progress.GetValueOrDefault(item.Id)" Repo="_repos.GetValueOrDefault(item.Id)" ShownPath="@ShownPath(item.Path)" Now="Time.GetUtcNow()" />
                </li>
            }
        </ul>
    }
</div>
