@page "/workspaces"
@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Code
@using Waymark.Host.Components.Shared
@using Waymark.Host.Ui

<PageTitle>Workspaces - Waymark</PageTitle>

<div class="wm-page">
    <h1 class="wm-title">Workspaces</h1>
    <p class="wm-lead">Folders Claude may read and, when you allow it, change. Nothing outside these folders is reachable.</p>

    @if (_error is not null)
    {
        <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
    }

    <section class="wm-card" aria-labelledby="ws-add">
        <h2 id="ws-add" class="wm-section">Add a workspace</h2>
        <div class="wm-row">
            <MudTextField T="string" Label="Name" @bind-Value="_name" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Short, for example waymark" />
            <MudTextField T="string" Label="Folder" @bind-Value="_path" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Full path to an existing folder: a C#, Python or Node project, or an empty folder to start one" Style="min-width:360px" />
            <MudButton Variant="Variant.Outlined" OnClick="CheckAsync" Disabled="@(string.IsNullOrWhiteSpace(_path))">Check folder</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_path) || string.IsNullOrWhiteSpace(_name))">Add workspace</MudButton>
        </div>

        @if (_check is { } check)
        {
            <div style="margin-top:12px" aria-live="polite">
                @if (check.IsValid && check.Metadata is { } meta)
                {
                    <StateChip State="StatusState.Healthy" Text="Folder looks right" />
                    <dl class="wm-dl" style="margin-top:8px">
                        <dt>Location</dt>
                        <dd class="wm-mono">@ShownPath(check.NormalizedPath ?? string.Empty)</dd>
                        @if (meta.SolutionFiles.Count > 0 || meta.ProjectFiles.Count > 0)
                        {
                            <dt>.NET</dt>
                            <dd>
                                @(meta.SolutionFiles.Count == 0 ? "no solution" : string.Join(", ", meta.SolutionFiles)),
                                @DisplayFormat.Count(meta.ProjectFiles.Count)@(meta.ProjectListTruncated ? "+" : string.Empty) project(s),
                                framework @(meta.DetectedFramework ?? "not detected")
                            </dd>
                        }
                        @if (meta.PythonProjectFiles.Count > 0 || meta.PythonSourceFiles > 0)
                        {
                            <dt>Python</dt>
                            <dd>
                                @DisplayFormat.Count(meta.PythonProjectFiles.Count) project(s)@(meta.PythonTool is null ? string.Empty : " managed by " + meta.PythonTool),
                                @DisplayFormat.Count(meta.PythonSourceFiles) source file(s)
                                @if (meta.PythonProjectFiles.Count > 0)
                                {
                                    <div class="wm-mono wm-muted">@string.Join(", ", meta.PythonProjectFiles.Take(5))</div>
                                }
                            </dd>
                        }
                        @if (meta.NodeProjectFiles.Count > 0 || meta.NodeSourceFiles > 0)
                        {
                            <dt>Node.js</dt>
                            <dd>
                                @DisplayFormat.Count(meta.NodeProjectFiles.Count) package.json@(meta.PackageManager is null ? string.Empty : ", " + meta.PackageManager),
                                @DisplayFormat.Count(meta.NodeSourceFiles) JavaScript/TypeScript file(s)
                                @if (meta.NodeProjectFiles.Count > 0)
                                {
                                    <div class="wm-mono wm-muted">@string.Join(", ", meta.NodeProjectFiles.Take(5))</div>
                                }
                            </dd>
                        }
                        @if (meta.SolutionFiles.Count == 0 && meta.ProjectFiles.Count == 0 && meta.PythonProjectFiles.Count == 0 && meta.PythonSourceFiles == 0 && meta.NodeProjectFiles.Count == 0 && meta.NodeSourceFiles == 0)
                        {
                            <dt>Contents</dt>
                            <dd>No project yet. That is fine: Claude can create the project and its files here.</dd>
                        }
                    </dl>
                }
                else
                {
                    <InlineAlert Severity="Severity.Warning">@check.Error</InlineAlert>
                }
            </div>
        }
    </section>

    <h2 class="wm-section" style="margin-top:24px">Your workspaces</h2>
    @if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.FolderOpen" Title="No workspaces yet" Text="Add a folder above. Waymark indexes it so Claude can search it quickly." />
    }
    else
    {
        <div class="wm-table-wrap">
            <table class="wm-table">
                <caption class="visually-hidden">Workspaces and their index state</caption>
                <thead>
                    <tr><th scope="col">Name</th><th scope="col">Status</th><th scope="col">Languages</th><th scope="col">Index</th><th scope="col">Last indexed</th><th scope="col">On</th><th scope="col">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        var state = StateOf(item);
                        <tr>
                            <th scope="row" class="wm-rowhead"><div>@item.Name</div><div class="wm-mono wm-muted">@ShownPath(item.Path)</div></th>
                            <td><StateChip State="state.State" Text="@state.Text" /> <span class="wm-muted">@ProgressText(item.Id)</span></td>
                            <td>
                                @foreach (var language in LanguagesOf(_stats.GetValueOrDefault(item.Id)))
                                {
                                    <span class="wm-chip info" title="@($"{language.Files} {language.Name} files indexed")">@language.Name @DisplayFormat.Count(language.Files)</span>
                                }
                            </td>
                            <td class="wm-stats">@StatsText(_stats.GetValueOrDefault(item.Id))</td>
                            <td>@DisplayFormat.Ago(item.LastIndexedUtc, Time.GetUtcNow())</td>
                            <td><MudSwitch T="bool" Value="item.Enabled" ValueChanged="v => ToggleAsync(item, v)" Color="Color.Primary" aria-label="@($"Enable {item.Name}")" /></td>
                            <td>
                                <div class="wm-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(!item.Enabled)" OnClick="() => Reindex(item)">Re-index</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="@($"/workspaces/{item.Id}/access")">Access rules</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveAsync(item)">Remove</MudButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
