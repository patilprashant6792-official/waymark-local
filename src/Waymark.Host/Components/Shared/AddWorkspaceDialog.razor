@inherits LiveComponentBase
@using MudBlazor

<MudDialog>
    <DialogContent>
        <div class="wm-stack">
            <p class="wm-muted wm-flush">Pick a folder Claude may read and, when you allow it, change. Waymark indexes it so Claude can search it quickly.</p>
            @if (_error is not null)
            {
                <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
            }
            <WmTextField Label="Folder" @bind-Value="_path" Immediate="true" Width="FieldWidth.Full" HelperText="Full path to an existing folder: a C#, Python or Node project, or an empty folder to start one" />
            <WmTextField Label="Name" @bind-Value="_name" Immediate="true" Width="FieldWidth.Full" HelperText="Short, for example waymark" />
            <div>
                <WmButton OnClick="CheckAsync" Disabled="@(string.IsNullOrWhiteSpace(_path))">Check folder</WmButton>
            </div>
            @if (_check is { } check)
            {
                <div aria-live="polite">
                    @if (check.IsValid && check.Metadata is { } meta)
                    {
                        <WmStatus State="StatusState.Healthy" Text="Folder looks right" />
                        <div class="wm-note">
                            <WorkspaceProjectSummary Meta="meta" Location="@check.NormalizedPath" />
                        </div>
                    }
                    else
                    {
                        <InlineAlert Severity="Severity.Warning">@check.Error</InlineAlert>
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <WmButton OnClick="Close">Cancel</WmButton>
        <WmButton Kind="ButtonKind.Primary" OnClick="AddAsync" Disabled="@(!CanAdd)">Add workspace</WmButton>
    </DialogActions>
</MudDialog>
