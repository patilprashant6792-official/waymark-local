<div class="wm-stack">
    <div class="wm-row spread">
        <span>@Label</span>
        <span class="wm-muted">@Used.ToString("N0") of @Max.ToString("N0")@(string.IsNullOrEmpty(Unit) ? "" : " " + Unit)</span>
    </div>
    <progress class="wm-progress @(Percent >= 80 ? "high" : "")" max="100" value="@Percent" aria-label="@Label" aria-valuetext="@($"{Used:N0} of {Max:N0}")"></progress>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int Used { get; set; }

    [Parameter]
    public int Max { get; set; } = 1;

    [Parameter]
    public string? Unit { get; set; }

    private int Percent => Max <= 0 ? 0 : (int)Math.Clamp(Used * 100L / Max, 0, 100);
}
