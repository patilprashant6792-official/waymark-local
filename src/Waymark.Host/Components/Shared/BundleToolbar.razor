@inherits LiveComponentBase

<div class="wm-actions">
    <WmButton Icon="@Icons.Material.Outlined.Download" OnClick="ExportAsync" Disabled="_busy">@ExportLabel</WmButton>
    <WmButton Icon="@Icons.Material.Outlined.Upload" OnClick="ImportAsync" Disabled="_busy">Import</WmButton>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <span class="wm-muted">@Hint</span>
    }
</div>
@if (_error is not null)
{
    <InlineAlert Severity="Severity.Warning">@_error</InlineAlert>
}
