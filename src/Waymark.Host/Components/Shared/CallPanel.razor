@implements IDisposable
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@if (State.OpenId is { } id)
{
    <aside class="wm-call-panel" aria-label="Call details" tabindex="-1" @ref="_panel" @onkeydown="OnKey">
        <div class="wm-call-bar">
            <span class="wm-call-ref wm-mono">#@id</span>
            @if (State.Sequence.Count > 0)
            {
                <WmIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" Label="Newer call" Disabled="@(State.Neighbour(-1) is null)" OnClick="() => State.Move(-1)" />
                <WmIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Label="Older call" Disabled="@(State.Neighbour(1) is null)" OnClick="() => State.Move(1)" />
            }
            <a class="wm-call-full" href="@($"calls/{id}")" title="Open as a full page" aria-label="Open as a full page">
                <MudIcon Icon="@Icons.Material.Outlined.OpenInFull" Size="Size.Small" />
            </a>
            <WmIconButton Icon="@Icons.Material.Outlined.Close" Label="Close call details (Esc)" OnClick="State.Close" />
        </div>
        <CallView Id="id" Compact="true" />
    </aside>
}
