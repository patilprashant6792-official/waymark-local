@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Transfer
@using Waymark.Host.Transfer

<MudDialog>
    <DialogContent>
        <div class="wm-stack">
            <p class="wm-muted" style="margin:0">@Intro</p>

            @if (_error is not null)
            {
                <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
            }

            @if (_report is null)
            {
                <div>
                    <label for="wm-bundle-file" style="display:block;margin-bottom:4px">Bundle file (.json)</label>
                    <InputFile id="wm-bundle-file" OnChange="OnFileAsync" accept=".json,application/json" disabled="@_busy" />
                </div>
            }

            @if (_busy)
            {
                <p class="wm-lead" aria-live="polite">Working...</p>
            }

            @if (_parsed is not null && _report is null)
            {
                @if (_parsed.Notes.Count > 0)
                {
                    <InlineAlert Severity="Severity.Warning" Title="Left out of the file">
                        <ul style="margin:4px 0 0;padding-left:20px">
                            @foreach (var note in _parsed.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </InlineAlert>
                }

                @foreach (var row in _rows)
                {
                    <section class="wm-card" @key="row.Source.Name" aria-label="@row.Source.Name">
                        <div class="wm-row spread">
                            <h3 class="wm-section" style="margin:0">@row.Source.Name</h3>
                            <span class="wm-muted">@FileSummary(row.Source)</span>
                        </div>
                        <div class="wm-row" style="margin-top:12px">
                            <MudSelect T="ImportAction" Label="What to do" Value="row.Action" ValueChanged="@((ImportAction value) => ActionChangedAsync(row, value))" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px" Disabled="_busy">
                                @if (TargetWorkspaceId is null)
                                {
                                    <MudSelectItem T="ImportAction" Value="ImportAction.MergeIntoExisting" Disabled="@(_existing.Count == 0)">Merge into a workspace I have</MudSelectItem>
                                    <MudSelectItem T="ImportAction" Value="ImportAction.CreateWorkspace">Create it as a new workspace</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem T="ImportAction" Value="ImportAction.MergeIntoExisting">Merge into this workspace</MudSelectItem>
                                }
                                <MudSelectItem T="ImportAction" Value="ImportAction.Skip">Skip it</MudSelectItem>
                            </MudSelect>

                            @if (row.Action == ImportAction.MergeIntoExisting && TargetWorkspaceId is null)
                            {
                                <MudSelect T="long" Label="Merge into" Value="row.TargetId" ValueChanged="@((long value) => TargetChangedAsync(row, value))" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px" Disabled="_busy">
                                    @foreach (var workspace in _existing)
                                    {
                                        <MudSelectItem T="long" Value="workspace.Id">@workspace.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (row.Action == ImportAction.CreateWorkspace)
                            {
                                <MudTextField T="string" Label="New name" Value="row.NewName" ValueChanged="@((string value) => NameChangedAsync(row, value))" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="64" Style="min-width:200px" Disabled="_busy" />
                                <MudTextField T="string" Label="Folder on this computer" Value="row.NewPath" ValueChanged="@((string value) => PathChangedAsync(row, value))" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="The full path of the project folder here. The file only suggests the folder it had on the other computer." Style="min-width:360px;flex:1" Disabled="_busy" />
                            }
                        </div>

                        @if (row.Action != ImportAction.Skip && row.Preview is { } preview)
                        {
                            <div aria-live="polite" style="margin-top:12px">
                                @if (preview.Problem is not null)
                                {
                                    <InlineAlert Severity="Severity.Warning">@preview.Problem</InlineAlert>
                                }
                                else if (preview.Plan is { } plan)
                                {
                                    @foreach (var line in PlanLines(preview, plan))
                                    {
                                        <div>@line</div>
                                    }

                                    @if (plan.RulesAllowingFileTypes > 0)
                                    {
                                        <div style="margin-top:8px"><InlineAlert Severity="Severity.Warning">@AllowText(plan)</InlineAlert></div>
                                    }
                                }
                            </div>
                        }
                    </section>
                }
            }
            else if (_report is not null)
            {
                @foreach (var item in _report)
                {
                    <section class="wm-card" @key="item.BundleName">
                        <strong>@item.BundleName</strong>
                        @if (item.Problem is not null)
                        {
                            <InlineAlert Severity="Severity.Warning">@item.Problem</InlineAlert>
                        }
                        else
                        {
                            <div>@ReportLine(item)</div>
                        }
                    </section>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_report is null)
        {
            <MudButton Variant="Variant.Outlined" OnClick="Close">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportAsync" Disabled="@(!CanImport)">Import</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
        }
    </DialogActions>
</MudDialog>
