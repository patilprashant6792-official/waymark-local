@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.Transfer
@using Waymark.Host.Transfer

<MudDialog>
    <DialogContent>
        <div class="wm-stack">
            <p class="wm-muted wm-flush">@Intro</p>

            @if (_error is not null)
            {
                <InlineAlert Severity="Severity.Error">@_error</InlineAlert>
            }

            @if (_report is null)
            {
                <div>
                    <label for="wm-bundle-file" class="wm-label-block">Bundle file (.json)</label>
                    <InputFile id="wm-bundle-file" OnChange="OnFileAsync" accept=".json,application/json" disabled="@_busy" />
                </div>
            }

            @if (_busy)
            {
                <p class="wm-lead" aria-live="polite">Working...</p>
            }

            @if (_parsed is not null && _report is null)
            {
                @if (_parsed.Notes.Count > 0)
                {
                    <InlineAlert Severity="Severity.Warning" Title="Left out of the file">
                        <ul class="wm-list">
                            @foreach (var note in _parsed.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </InlineAlert>
                }

                @foreach (var row in _rows)
                {
                    <section class="wm-card" @key="row.Source.Name" aria-label="@row.Source.Name">
                        <div class="wm-row spread">
                            <h3 class="wm-card-title wm-flush">@row.Source.Name</h3>
                            <span class="wm-muted">@FileSummary(row.Source)</span>
                        </div>
                        <div class="wm-row wm-note">
                            <WmSelect TValue="ImportAction" Label="What to do" Width="FieldWidth.Large" Value="row.Action" ValueChanged="@((ImportAction value) => ActionChangedAsync(row, value))" Options="ActionOptions" Disabled="_busy" />

                            @if (row.Action == ImportAction.MergeIntoExisting && TargetWorkspaceId is null)
                            {
                                <WmSelect TValue="long" Label="Merge into" Value="row.TargetId" ValueChanged="@((long value) => TargetChangedAsync(row, value))" Options="ExistingOptions" Disabled="_busy" />
                            }

                            @if (row.Action == ImportAction.CreateWorkspace)
                            {
                                <WmTextField Label="New name" Value="row.NewName" ValueChanged="@((string value) => NameChangedAsync(row, value))" MaxLength="64" Width="FieldWidth.Small" Disabled="_busy" />
                                <WmTextField Label="Folder on this computer" Value="row.NewPath" ValueChanged="@((string value) => PathChangedAsync(row, value))" HelperText="The full path of the project folder here. The file only suggests the folder it had on the other computer." Width="FieldWidth.Large" Disabled="_busy" />
                            }
                        </div>

                        @if (row.Action != ImportAction.Skip && row.Preview is { } preview)
                        {
                            <div aria-live="polite" class="wm-note">
                                @if (preview.Problem is not null)
                                {
                                    <InlineAlert Severity="Severity.Warning">@preview.Problem</InlineAlert>
                                }
                                else if (preview.Plan is { } plan)
                                {
                                    @foreach (var line in PlanLines(preview, plan))
                                    {
                                        <div>@line</div>
                                    }

                                    @if (plan.RulesAllowingFileTypes > 0)
                                    {
                                        <InlineAlert Severity="Severity.Warning">@AllowText(plan)</InlineAlert>
                                    }
                                }
                            </div>
                        }
                    </section>
                }
            }
            else if (_report is not null)
            {
                @foreach (var item in _report)
                {
                    <section class="wm-card" @key="item.BundleName">
                        <strong>@item.BundleName</strong>
                        @if (item.Problem is not null)
                        {
                            <InlineAlert Severity="Severity.Warning">@item.Problem</InlineAlert>
                        }
                        else
                        {
                            <div>@ReportLine(item)</div>
                        }
                    </section>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_report is null)
        {
            <WmButton OnClick="Close">Cancel</WmButton>
            <WmButton Kind="ButtonKind.Primary" OnClick="ImportAsync" Disabled="@(!CanImport)">Import</WmButton>
        }
        else
        {
            <WmButton Kind="ButtonKind.Primary" OnClick="Close">Close</WmButton>
        }
    </DialogActions>
</MudDialog>
