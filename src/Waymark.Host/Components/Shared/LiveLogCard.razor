@inherits LiveComponentBase
@using MudBlazor
@using Waymark.Core.LiveFeed
@using Waymark.Host.Ui
@inject CallPanelState Calls

<section class="wm-panel" aria-labelledby="live-card-title">
    <header class="wm-panel-head">
        <h2 id="live-card-title">Live log<ActivityDot Token="@_version.ToString()" /></h2>
<a class="wm-expand" href="audit?view=live" title="Open the full live log" aria-label="Open the full live log">
            <MudIcon Icon="@Icons.Material.Outlined.OpenInFull" Size="Size.Small" />
        </a>
    </header>
    <div id="@TerminalId" class="wm-term wm-live-term wm-live-mini" tabindex="0" role="log" aria-live="off" aria-label="Latest live activity">
        @if (_rows.Count == 0)
        {
            <div class="wm-live-empty">Waiting for activity. Tool calls, file changes, sign-ins and commands show up here.</div>
        }

        @{ var shownWhy = new HashSet<long>(); }
        @foreach (var entry in _rows)
        {
            var (text, why) = ActivityLogging.SplitWhy(entry.Message);
            if (LiveLineFormat.RunIdOf(entry) is { } runId && !shownWhy.Add(runId))
            {
                why = string.Empty;
            }
            <div class="wm-term-line wm-live-line @LiveLineFormat.LevelClass(entry.Level)" @key="entry.Id" data-flash="@(Changes.Phase($"line:{entry.Id}", string.Empty))">
                <span class="wm-live-time">@DisplayFormat.Clock(entry.TimestampUtc)</span>
                <span class="wm-live-kind @LiveLineFormat.KindWord(entry.Kind)">@LiveLineFormat.KindWord(entry.Kind)</span>
                <span class="wm-live-lvl">@LiveLineFormat.LevelWord(entry.Level)</span>
                <span class="wm-live-msg">
                    @text
                    @if (why.Length > 0)
                    {
                        <span class="wm-live-why">@why</span>
                    }
                </span>
                @if (LiveLineFormat.CallIdOf(entry) is { } callId)
                {
                    <WmLinkButton title="Open this call: its input and output" OnClick="() => Calls.Open(callId)">open</WmLinkButton>
                }
            </div>
        }
    </div>
</section>
