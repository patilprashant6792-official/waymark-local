@using Waymark.Core.Commands

@* What an operation can do to this computer. Only the two that need a second look use colour: reading is quiet green, the rest of the risk is said in words. *@
<WmTag Tone="ToneOf" Text="@RiskTiers.Label(Tier)" Title="@RiskTiers.Hint(Tier)" />

@code {
    /// <summary>The operation whose risk is shown: what it can do to this computer and the data on it.</summary>
    [Parameter, EditorRequired]
    public OperationInfo Operation { get; set; } = default!;

    private RiskTier Tier => RiskTiers.Of(Operation);

    private Tone ToneOf => Tier switch
    {
        RiskTier.Look => Tone.Ok,
        RiskTier.Change => Tone.Neutral,
        _ => Tone.Warn
    };
}
