<aside id="wm-shortcuts" class="wm-shortcuts" role="dialog" aria-label="Keyboard shortcuts" tabindex="-1" hidden>
    <h2 class="wm-card-title">Keyboard shortcuts</h2>
    <dl class="wm-dl">
        <dt><kbd>Ctrl K</kbd></dt>
        <dd>Go to a page</dd>
        <dt><kbd>/</kbd></dt>
        <dd>Search the audit trail or the console output</dd>
        <dt><kbd>?</kbd></dt>
        <dd>Show or hide this list</dd>
        <dt><kbd>[</kbd></dt>
        <dd>Collapse or expand the menu</dd>
        <dt><kbd>Esc</kbd></dt>
        <dd>Close this list, the page picker or a details panel</dd>
    </dl>
    <h3 class="wm-card-title wm-card-actions">On the Console page</h3>
    <dl class="wm-dl">
        <dt><kbd>n</kbd> <kbd>N</kbd></dt>
        <dd>Next or previous match of the search</dd>
        <dt><kbd>e</kbd></dt>
        <dd>Jump to the next error</dd>
        <dt><kbd>w</kbd></dt>
        <dd>Wrap or unwrap long lines</dd>
    </dl>
</aside>
