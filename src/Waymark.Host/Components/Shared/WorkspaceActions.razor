@inherits LiveComponentBase

<div class="wm-ws-actions" role="group" aria-label="@($"Actions for {Workspace.Name}")">
    <WmSwitch Value="Workspace.Enabled" ValueChanged="ToggleAsync" Disabled="_busy" Label="@($"Enable {Workspace.Name}")"
              Tooltip="@(Workspace.Enabled ? "On: Claude can use this workspace. Switch it off to put it out of reach." : "Off: Claude cannot see this workspace.")" />
    @if (Labels)
    {
        <WmButton Small="true" Icon="@Icons.Material.Outlined.Refresh" Disabled="@(!Workspace.Enabled)" OnClick="Reindex">Re-index</WmButton>
        <WmButton Kind="ButtonKind.Danger" Small="true" Icon="@Icons.Material.Outlined.Delete" OnClick="RemoveAsync">Remove</WmButton>
    }
    else
    {
        <WmIconButton Icon="@Icons.Material.Outlined.Refresh" Label="@($"Re-index {Workspace.Name}")" Disabled="@(!Workspace.Enabled)" OnClick="Reindex" />
        <WmIconButton Icon="@Icons.Material.Outlined.Delete" Label="@($"Remove {Workspace.Name}")" OnClick="RemoveAsync" />
    }
</div>
