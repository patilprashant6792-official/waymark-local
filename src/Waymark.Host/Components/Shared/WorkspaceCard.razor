@using Waymark.Core.Code
@using Waymark.Core.Commands
@using Waymark.Core.Memory
@using Waymark.Core.Workspaces
@using Waymark.Host.Ui

@{
    var status = WorkspaceView.StatusOf(Workspace, Progress);
    var languages = WorkspaceView.LanguagesOf(Stats);
    var progressText = WorkspaceView.ProgressText(Progress);
}
<article class="wm-tile wm-ws-card @WorkspaceView.AccentOf(status.State) @(Workspace.Enabled ? string.Empty : "is-off") @(LiveCount > 0 ? "wm-ws-live" : string.Empty)">
    <header class="wm-ws-card-head">
        <span class="wm-ico"><MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" /></span>
        <h2 class="wm-ws-name"><a class="wm-ws-link" href="@WorkspaceSections.Overview.Href(Workspace.Id)">@Workspace.Name</a></h2>
        @if (Repo is { } repo)
        {
            <a class="wm-ws-gh" href="@repo.Url" target="_blank" rel="noopener noreferrer" title="@GitHubTitle(repo)" aria-label="@($"Open {repo.FullName} on GitHub (new tab)")">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Medium" />
            </a>
        }
    </header>
    <div class="wm-muted wm-mono wm-ellipsis" title="@ShownPath">@ShownPath</div>
    <div class="wm-row">
        <WmStatus State="status.State" Text="@status.Text" />
        @if (progressText.Length > 0)
        {
            <span class="wm-muted">@progressText</span>
        }
        @if (LiveCount > 0)
        {
            <WmStatus State="StatusState.Healthy" Live="true" Text="@($"{LiveCount} running")" />
        }
        @if (Crashed > 0)
        {
            <WmStatus State="StatusState.Failed" Text="@($"{Crashed} crashed")" />
        }
    </div>
    @if (ShownTerminals.Count > 0)
    {
        <TerminalRows Items="ShownTerminals" Now="Now" Compact="true" />
    }
    @if (languages.Count > 0)
    {
        <div class="wm-row wm-ws-chips">
            @foreach (var language in languages)
            {
                <WmTag Text="@($"{language.Name} {DisplayFormat.Count(language.Files)}")" Title="@($"{language.Files} {language.Name} files indexed")" />
            }
        </div>
    }
    <p class="wm-tile-sub">@WorkspaceView.StatsText(Stats)</p>
    <p class="wm-tile-sub">
        <a href="@WorkspaceSections.Flows.Href(Workspace.Id)">@MemoryText</a>
    </p>
    <footer class="wm-ws-foot">
        <span class="wm-muted">Indexed @DisplayFormat.Ago(Workspace.LastIndexedUtc, Now)</span>
        <WorkspaceActions Workspace="Workspace" />
    </footer>
</article>

@code {
    [Parameter, EditorRequired]
    public Workspace Workspace { get; set; } = default!;

    [Parameter]
    public CodeIndexStats? Stats { get; set; }

    [Parameter]
    public CodeIndexProgress? Progress { get; set; }

    /// <summary>The workspace's flows and active notes; null when it has none (or they are not loaded yet).</summary>
    [Parameter]
    public MemoryTotals? Memory { get; set; }

    /// <summary>Set when the workspace folder is the root of a GitHub checkout.</summary>
    [Parameter]
    public GitHubRepo? Repo { get; set; }

    /// <summary>The folder as the list shows it, without the part every workspace shares.</summary>
    [Parameter]
    public string ShownPath { get; set; } = string.Empty;

    [Parameter]
    public DateTimeOffset Now { get; set; }

    /// <summary>The workspace's terminals; the card shows the running ones and those that crashed in the last hour.</summary>
    [Parameter]
    public IReadOnlyList<TerminalInfo> Terminals { get; set; } = [];

    private int LiveCount => Terminals.Count(t => t.Terminal.State.IsLive());

    private int Crashed => Terminals.Count(RecentCrash);

    private IReadOnlyList<TerminalInfo> ShownTerminals => Terminals.Where(t => t.Terminal.State.IsLive() || RecentCrash(t)).ToList();

    private bool RecentCrash(TerminalInfo info) =>
        info.Terminal.State == TerminalState.Crashed && info.Terminal.EndedUtc is { } ended && Now - ended < TimeSpan.FromHours(1);

    private static string GitHubTitle(GitHubRepo repo) =>
        repo.Branch is null ? $"{repo.FullName} on GitHub" : $"{repo.FullName} on GitHub (branch {repo.Branch})";

    private string MemoryText => Memory is { } totals && (totals.Flows > 0 || totals.Notes > 0)
        ? $"{DisplayFormat.Count(totals.Flows)} {(totals.Flows == 1 ? "flow" : "flows")} · {DisplayFormat.Count(totals.Notes)} {(totals.Notes == 1 ? "note" : "notes")}"
        : "No memory yet";
}
