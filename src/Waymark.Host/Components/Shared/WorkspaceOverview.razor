@inherits LiveComponentBase
@using Waymark.Core.Memory
@using Waymark.Host.Ui

@{
    var languages = WorkspaceView.LanguagesOf(_stats);
}
<section class="wm-card" aria-labelledby="ov-index">
    <h2 id="ov-index" class="wm-card-title">Index</h2>
    @if (!Workspace.Enabled)
    {
        <InlineAlert Severity="Severity.Info">This workspace is switched off. Claude cannot see it, and it is not indexed until you switch it on.</InlineAlert>
    }
    <dl class="wm-dl">
        <dt>Files</dt>
        <dd>@(_stats is null ? "-" : DisplayFormat.Count(_stats.Files))</dd>
        <dt>Types</dt>
        <dd>@(_stats is null ? "-" : DisplayFormat.Count(_stats.Types))</dd>
        <dt>Members</dt>
        <dd>@(_stats is null ? "-" : DisplayFormat.Count(_stats.Members))</dd>
        <dt>Languages</dt>
        <dd>
            @if (languages.Count == 0)
            {
                <span class="wm-muted">None indexed yet</span>
            }
            else
            {
                <span class="wm-row wm-ws-chips">
                    @foreach (var language in languages)
                    {
                        <WmTag Text="@($"{language.Name} {DisplayFormat.Count(language.Files)}")" Title="@($"{language.Files} {language.Name} files indexed")" />
                    }
                </span>
            }
        </dd>
        <dt>Last indexed</dt>
        <dd>@DisplayFormat.Ago(Workspace.LastIndexedUtc, Time.GetUtcNow())</dd>
        <dt>Added</dt>
        <dd>@DisplayFormat.DateAndClock(Workspace.AddedUtc)</dd>
    </dl>
</section>

<section class="wm-card" aria-labelledby="ov-memory">
    <h2 id="ov-memory" class="wm-card-title">Memory</h2>
    @if (Counts is not { } counts)
    {
        <p class="wm-muted" aria-live="polite">Loading...</p>
    }
    else
    {
        var health = MemoryHealth;
        <dl class="wm-dl">
            <dt>Flows</dt>
            <dd>
                <a href="@FlowsHref">@DisplayFormat.Count(counts.Flows)</a>
                @if (counts.Flows == 0)
                {
                    <span class="wm-muted"> - an agent saves one after tracing a feature</span>
                }
                else
                {
                    <span class="wm-muted"> · @DisplayFormat.Count(counts.Steps) steps</span>
                }
            </dd>
            @if (counts.UnorderedFlows > 0)
            {
                <dt>Unordered flows</dt>
                <dd><a href="@FlowsHref">@DisplayFormat.Count(counts.UnorderedFlows)</a> <span class="wm-muted">saved before flows existed</span></dd>
            }
            <dt>Notes</dt>
            <dd>
                <a href="@NotesHref()">@DisplayFormat.Count(counts.Notes)</a>
                @if (counts.Notes == 0)
                {
                    <span class="wm-muted"> - you or an agent can add one</span>
                }
            </dd>
            <dt>Pinned</dt>
            <dd><a href="@NotesHref("pinned")">@counts.Pinned of @NoteRules.MaxPinned</a> <span class="wm-muted">in the workspace guide</span></dd>
            <dt>From agents</dt>
            <dd><a href="@NotesHref("agents")">@DisplayFormat.Count(counts.FromAgents)</a></dd>
            @if (counts.Detached > 0)
            {
                <dt>Detached notes</dt>
                <dd><a href="@NotesHref("detached")">@DisplayFormat.Count(counts.Detached)</a> <span class="wm-muted">their flow was deleted</span></dd>
            }
            <dt>Never used</dt>
            <dd>@DisplayFormat.Count(counts.FlowsNeverUsed) flows · @DisplayFormat.Count(counts.NotesNeverUsed) notes <span class="wm-muted">not opened by an agent yet</span></dd>
            <dt>Last used</dt>
            <dd>
                @if (counts.FlowLastUsedName is { } lastFlow)
                {
                    <a href="@($"{FlowsHref}#fm-{counts.FlowLastUsedId}")" title="@ExactTime(counts.FlowLastUsedUtc)">@lastFlow</a>
                    <span class="wm-muted" title="@ExactTime(counts.FlowLastUsedUtc)"> @LastUsedText(counts.FlowLastUsedUtc)</span>
                }
                else
                {
                    <span class="wm-muted">No flow opened by an agent yet</span>
                }
                @if (counts.NoteLastUsedUtc is not null)
                {
                    <span class="wm-muted" title="@ExactTime(counts.NoteLastUsedUtc)"> · a note @LastUsedText(counts.NoteLastUsedUtc)</span>
                }
            </dd>
            <dt>May be stale</dt>
            <dd>
                @if (health.StaleNotes is { } stale)
                {
                    <a href="@NotesHref("stale")">@DisplayFormat.Count(stale)</a>
                    <span class="wm-muted"> notes, checked @LastUsedText(health.StaleCheckedUtc)</span>
                }
                else
                {
                    <span class="wm-muted">Not checked yet · </span><a href="@NotesHref("stale")">Check</a>
                }
            </dd>
            <dt>Links that do not call</dt>
            <dd>
                @if (health.BrokenLinks is { } broken)
                {
                    <a href="@FlowsHref">@DisplayFormat.Count(broken)</a>
                    <span class="wm-muted"> · @DisplayFormat.Count(health.MissingSteps ?? 0) steps not on this branch, checked @LastUsedText(health.LinksCheckedUtc)</span>
                }
                else
                {
                    <span class="wm-muted">Not checked yet · </span><a href="@FlowsHref">Check</a>
                }
            </dd>
        </dl>
    }
</section>

<section class="wm-card" aria-labelledby="ov-projects">
    <h2 id="ov-projects" class="wm-card-title">Projects found</h2>
    @if (_scanning)
    {
        <p class="wm-muted" aria-live="polite">Scanning the folder...</p>
    }
    else if (_scanError is not null)
    {
        <InlineAlert Severity="Severity.Warning">@_scanError</InlineAlert>
    }
    else if (_meta is not null)
    {
        <WorkspaceProjectSummary Meta="_meta" />
    }
</section>
