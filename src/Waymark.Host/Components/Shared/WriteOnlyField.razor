@using MudBlazor

<div class="wm-stack">
    <div class="wm-row">
        <strong>@Label</strong>
        @if (IsSet)
        {
            <WmStatus State="StatusState.Healthy" Text="@StoredText" />
        }
        else
        {
            <WmStatus State="StatusState.Off" Text="Not set" />
        }
    </div>

    @if (!_editing && IsSet)
    {
        <div class="wm-row">
            <WmButton OnClick="StartEdit">Rotate</WmButton>
            @if (OnClear.HasDelegate)
            {
                <WmButton Kind="ButtonKind.Danger" OnClick="ClearAsync">Remove</WmButton>
            }
        </div>
    }
    else
    {
        <WmTextField @bind-Value="_value" Label="@(IsSet ? "New value" : "Value")" InputType="InputType.Password" Immediate="true" HelperText="@HelperText" Disabled="_busy" Width="FieldWidth.Full" />
        <div class="wm-row">
            <WmButton Kind="ButtonKind.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_value))" OnClick="SaveAsync">Save</WmButton>
            @if (IsSet)
            {
                <WmButton Kind="ButtonKind.Ghost" OnClick="Cancel">Cancel</WmButton>
            }
        </div>
    }
</div>

@code {
    private string? _value;
    private bool _editing;
    private bool _busy;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public bool IsSet { get; set; }

    /// <summary>The last characters of the stored value; nothing else about it is ever shown.</summary>
    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnSave { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    private string StoredText => string.IsNullOrEmpty(Hint) ? "Stored" : $"Stored \u00b7 ends in {Hint}";

    private void StartEdit()
    {
        _value = null;
        _editing = true;
    }

    private void Cancel()
    {
        _value = null;
        _editing = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_value))
        {
            return;
        }

        _busy = true;
        try
        {
            await OnSave.InvokeAsync(_value);
            _value = null;
            _editing = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearAsync()
    {
        _busy = true;
        try
        {
            await OnClear.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
