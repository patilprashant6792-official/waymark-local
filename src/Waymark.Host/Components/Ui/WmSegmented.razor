@typeparam TValue

@* One segmented control for every Off/Ask/Auto, profile and view switch. It is a radio group: the chosen option is aria-checked. *@
<div class="wm-seg @CssClass" role="radiogroup" aria-label="@Label">
    @foreach (var option in Options)
    {
        var chosen = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
        var value = option.Value;
        <button type="button"
                role="radio"
                class="wm-seg-btn @option.CssClass"
                aria-checked="@(chosen ? "true" : "false")"
                aria-pressed="@(chosen ? "true" : "false")"
                title="@option.Title"
                disabled="@(Disabled || option.Disabled)"
                @onclick="() => Choose(value)">@option.Label</button>
    }
</div>

@code {
    /// <summary>The name of the group for screen readers.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<WmOption<TValue>> Options { get; set; } = [];

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private async Task Choose(TValue value)
    {
        if (EqualityComparer<TValue>.Default.Equals(value, Value))
        {
            return;
        }

        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
