@typeparam TValue
@using MudBlazor

@* The only dropdown pages may use. Choices are data (WmOption), the width comes from the same scale as text fields. *@
<MudSelect T="TValue"
           Class="@WidthClass"
           Variant="Variant.Outlined"
           Margin="Margin.Dense"
           Label="@Label"
           HelperText="@HelperText"
           Value="Value"
           ValueChanged="ValueChanged"
           Disabled="Disabled">
    @foreach (var option in Options)
    {
        <MudSelectItem T="TValue" Value="option.Value" Disabled="option.Disabled">@option.Label</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<WmOption<TValue>> Options { get; set; } = [];

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public FieldWidth Width { get; set; } = FieldWidth.Medium;

    private string WidthClass => Width switch
    {
        FieldWidth.Small => "wm-w-sm",
        FieldWidth.Large => "wm-w-lg",
        FieldWidth.Full => "wm-w-full",
        _ => "wm-w-md"
    };
}
