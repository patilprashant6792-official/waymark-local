@* A pill that is either on or off (follow, wrap lines). Pressed is announced to screen readers as aria-pressed. *@
<button type="button" class="wm-toggle @(Pressed ? "on" : null)" aria-pressed="@(Pressed ? "true" : "false")" disabled="@Disabled" @attributes="Attributes" @onclick="OnClick">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <MudIcon Icon="@Icon" Size="Size.Small" />
    }
    <span>@ChildContent</span>
</button>

@code {
    [Parameter]
    public bool Pressed { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>An id or data attribute a script needs to find the toggle.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; } = new();
}
